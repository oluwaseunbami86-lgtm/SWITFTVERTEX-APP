# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres (leave blank locally to fall back to SQLite)
DATABASE_URL=

# Cloudflare R2 / S3-compatible storage (leave blank locally to use local media/)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto

# Password-reset email (console backend prints emails in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SwiftVertex Geomatics <no-reply@yourdomain.com>

# Self-service sign-ups wait for admin approval unless this is False
SIGNUP_REQUIRES_APPROVAL=True

# Optional: links shown on the sign-up form
TERMS_URL=
PRIVACY_URL=

# --- Production database (Supabase Postgres) ---
# Use the Supabase "Session pooler" connection string (works from Render).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60
# DB_POOLER_TRANSACTION_MODE=False

# --- Survey file storage: Cloudflare R2 (private bucket) ---
# Put the real values ONLY in Render's environment settings / your local .env. Never commit them.
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=swiftvertex-survey-files
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MAX_UPLOAD_MB=250
# OVERWRITE_RETENTION_DAYS=30
